<div class="ggel-scroll">

  <header class="ggel-header">
    <div class="ggel-kicker">{{localize "GGEL.subtitle"}}</div>
    <h1 class="ggel-title">{{localize "GGEL.title"}}</h1>
    <div class="ggel-rule" aria-hidden="true"><span class="ggel-lozenge"></span></div>
  </header>

  {{!-- ------------------------------ GRUPO ------------------------------ --}}
  <section class="ggel-panel">
    <div class="ggel-panel-head">
      <h2>{{localize "GGEL.ui.party"}}</h2>
      <div class="ggel-actions">
        <button type="button" class="ggel-btn ggel-btn-ghost" data-action="selectAll">
          {{localize "GGEL.ui.selectAll"}}
        </button>
        <button type="button" class="ggel-btn ggel-btn-ghost" data-action="selectNone">
          {{localize "GGEL.ui.selectNone"}}
        </button>
      </div>
    </div>
    <p class="ggel-hint">{{localize "GGEL.ui.partyHint"}}</p>

    {{#if characters.length}}
      <ul class="ggel-grid">
        {{#each characters}}
          <li class="ggel-card {{#if this.selected}}is-selected{{/if}}" data-tooltip="{{this.name}}">
            <label>
              <input type="checkbox" data-pc-toggle="{{this.id}}" {{checked this.selected}}>
              <img src="{{this.img}}" alt="" loading="lazy">
              <span class="ggel-card-name">{{this.name}}</span>
              {{#if this.level}}
                <span class="ggel-tag">{{localize "GGEL.ui.level" level=this.level}}</span>
              {{/if}}
            </label>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="ggel-empty">{{localize "GGEL.ui.emptyParty"}}</p>
    {{/if}}
  </section>

  {{!-- ---------------------------- ENCUENTRO ---------------------------- --}}
  <section class="ggel-panel">
    <div class="ggel-panel-head">
      <h2>{{localize "GGEL.ui.encounter"}}</h2>
      <div class="ggel-actions">
        <button type="button" class="ggel-btn ggel-btn-ghost" data-action="fromCanvas">
          <i class="fa-solid fa-crosshairs"></i> {{localize "GGEL.ui.useSelected"}}
        </button>
        <button type="button" class="ggel-btn ggel-btn-ghost" data-action="fromCombat">
          <i class="fa-solid fa-khanda"></i> {{localize "GGEL.ui.useCombat"}}
        </button>
        {{#if hasEncounter}}
          <button type="button" class="ggel-btn ggel-btn-ghost" data-action="clearEncounter">
            {{localize "GGEL.ui.clear"}}
          </button>
        {{/if}}
      </div>
    </div>
    <p class="ggel-hint">{{localize "GGEL.ui.encounterHint"}}</p>

    {{!-- Monstruos ya cargados, con control de cantidad --}}
    {{#if monsters.length}}
      <ul class="ggel-grid ggel-chosen">
        {{#each monsters}}
          <li class="ggel-card is-monster" data-tooltip="{{this.name}}">
            <img src="{{this.img}}" alt="" loading="lazy">
            <span class="ggel-card-name">{{this.name}}</span>
            {{#if this.cr}}
              <span class="ggel-tag ggel-tag-cr">{{localize "GGEL.ui.cr" cr=this.cr}}</span>
            {{/if}}
            <span class="ggel-qty">
              <button type="button" data-action="bumpCount" data-actor-id="{{this.actorId}}"
                      data-delta="-1" data-tooltip="{{localize 'GGEL.ui.less'}}">−</button>
              <b>{{this.count}}</b>
              <button type="button" data-action="bumpCount" data-actor-id="{{this.actorId}}"
                      data-delta="1" data-tooltip="{{localize 'GGEL.ui.more'}}">+</button>
            </span>
            <button type="button" class="ggel-remove" data-action="removeMonster"
                    data-actor-id="{{this.actorId}}" data-tooltip="{{localize 'GGEL.ui.remove'}}">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="ggel-empty">{{localize "GGEL.ui.emptyEncounter"}}</p>
    {{/if}}

    {{!-- Buscador de PNJs del mundo --}}
    <div class="ggel-picker">
      <div class="ggel-picker-controls">
        <input type="search" data-npc-search class="ggel-search"
               placeholder="{{localize 'GGEL.ui.searchNpc'}}" autocomplete="off">
        <select data-npc-folder class="ggel-folder">
          <option value="">{{localize "GGEL.ui.allFolders"}}</option>
          {{#each folders}}
            <option value="{{this.id}}">{{this.name}}</option>
          {{/each}}
        </select>
      </div>

      <ul class="ggel-npc-list">
        {{#each npcs}}
          <li class="ggel-npc" data-npc-row data-search="{{this.search}}" data-folder="{{this.folderId}}">
            <img src="{{this.img}}" alt="" loading="lazy">
            <span class="ggel-npc-name">{{this.name}}</span>
            {{#if this.folder}}<span class="ggel-npc-folder">{{this.folder}}</span>{{/if}}
            {{#if this.cr}}
              <span class="ggel-tag ggel-tag-cr">{{localize "GGEL.ui.cr" cr=this.cr}}</span>
            {{/if}}
            <button type="button" class="ggel-add" data-action="addNpc"
                    data-actor-id="{{this.id}}" data-tooltip="{{localize 'GGEL.ui.add'}}">
              <i class="fa-solid fa-plus"></i>
            </button>
          </li>
        {{/each}}
      </ul>
      <p class="ggel-empty" data-npc-empty hidden>{{localize "GGEL.ui.noMatches"}}</p>
      {{#if npcCapped}}
        <p class="ggel-hint">{{localize "GGEL.ui.capped" total=npcTotal}}</p>
      {{/if}}
    </div>

    {{!-- Encuentros guardados --}}
    <div class="ggel-saved">
      <div class="ggel-saved-controls">
        <input type="text" data-enc-name class="ggel-search"
               placeholder="{{localize 'GGEL.ui.encName'}}" autocomplete="off">
        <button type="button" class="ggel-btn ggel-btn-ghost" data-action="saveEncounter">
          <i class="fa-solid fa-floppy-disk"></i> {{localize "GGEL.ui.save"}}
        </button>
      </div>

      {{#if saved.length}}
        <ul class="ggel-saved-list">
          {{#each saved}}
            <li class="ggel-chip">
              <button type="button" class="ggel-chip-load" data-action="loadEncounter"
                      data-enc-id="{{this.id}}" data-tooltip="{{localize 'GGEL.ui.load'}}">
                <i class="fa-solid fa-folder-open"></i> {{this.name}}
              </button>
              <button type="button" class="ggel-chip-del" data-action="deleteEncounter"
                      data-enc-id="{{this.id}}" data-tooltip="{{localize 'GGEL.ui.delete'}}">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </li>
          {{/each}}
        </ul>
      {{/if}}
    </div>
  </section>

  {{!-- ------------------------------ ACCIÓN ----------------------------- --}}
  <div class="ggel-cta">
    <button type="button" class="ggel-btn ggel-btn-primary" data-action="analyze"
            {{#unless hasParty}}disabled{{/unless}}>
      <i class="fa-solid fa-eye"></i> {{localize "GGEL.ui.analyze"}}
    </button>
  </div>

  {{!-- ------------------------------ INFORME ---------------------------- --}}
  <section class="ggel-panel ggel-report">
    <div class="ggel-panel-head">
      <h2>{{localize "GGEL.ui.briefing"}}</h2>
      {{#if report}}
        <div class="ggel-actions">
          <button type="button" class="ggel-btn ggel-btn-ghost" data-action="copy">
            <i class="fa-solid fa-copy"></i> {{localize "GGEL.ui.copy"}}
          </button>
        </div>
      {{/if}}
    </div>

    {{#if report}}
      <p class="ggel-verdict">{{report.verdict}}</p>
      <ul class="ggel-notes">
        {{#each report.notes}}
          <li class="ggel-note is-{{this.sev}}">
            <span class="ggel-note-icon" aria-hidden="true">{{this.icon}}</span>
            <div class="ggel-note-text">
              <p class="ggel-note-head">{{this.head}}</p>
              <p class="ggel-note-body">{{this.body}}</p>
            </div>
          </li>
        {{/each}}
        <li class="ggel-note is-{{report.baseline.sev}} ggel-baseline">
          <span class="ggel-note-icon" aria-hidden="true">{{report.baseline.icon}}</span>
          <div class="ggel-note-text">
            <p class="ggel-note-head">{{report.baseline.head}}</p>
            <p class="ggel-note-body">{{report.baseline.body}}</p>
          </div>
        </li>
      </ul>
    {{else}}
      <p class="ggel-empty">{{localize "GGEL.ui.emptyReport"}}</p>
    {{/if}}
  </section>

  {{!-- ---------------------------- PLAN DE COMBATE ---------------------- --}}
  <section class="ggel-panel ggel-plan">
    <div class="ggel-panel-head">
      <h2>{{localize "GGEL.ui.plan"}}</h2>
      <div class="ggel-actions">
        <label class="ggel-rounds">
          {{localize "GGEL.ui.rounds"}}
          <select data-rounds>
            {{#each roundOptions}}
              <option value="{{this.n}}" {{#if this.selected}}selected{{/if}}>{{this.n}}</option>
            {{/each}}
          </select>
        </label>
      </div>
    </div>
    <p class="ggel-hint">{{localize "GGEL.ui.planHint"}}</p>

    {{#if plan}}
      {{#each plan.rounds}}
        <div class="ggel-round">
          <div class="ggel-round-label">{{this.label}}</div>
          <ul class="ggel-moves">
            {{#each this.entries}}
              <li class="ggel-move is-{{this.activation}}">
                <p class="ggel-move-head">{{this.head}}</p>
                <p class="ggel-move-body">{{this.body}}</p>
              </li>
            {{/each}}
          </ul>
        </div>
      {{/each}}

      {{#if plan.contingencies.length}}
        <div class="ggel-round ggel-contingencies">
          <div class="ggel-round-label">{{localize "GGEL.ui.contingencies"}}</div>
          <ul class="ggel-moves">
            {{#each plan.contingencies}}
              <li class="ggel-move is-contingency">
                <p class="ggel-move-head">{{this.head}}</p>
                <p class="ggel-move-body">{{this.body}}</p>
              </li>
            {{/each}}
          </ul>
        </div>
      {{/if}}
    {{else}}
      <p class="ggel-empty">{{localize "GGEL.ui.emptyPlan"}}</p>
    {{/if}}
  </section>

</div>
